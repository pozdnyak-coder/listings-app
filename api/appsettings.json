{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=listings.db"
  },
  "Jwt": {
    "Issuer": "listings-api",
    "Audience": "listings-client",
    "ExpiresMinutes": 60
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
