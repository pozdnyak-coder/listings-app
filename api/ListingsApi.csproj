<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ListingsApi</RootNamespace>
    <UserSecretsId>listings-api-7f3c1b52</UserSecretsId>
  </PropertyGroup>

  <!-- Версии с «*» берут последний выпуск линейки: так проект собирается и сегодня, и через полгода -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <!-- Design нужен команде dotnet ef; без PrivateAssets, чтобы тестовый проект тоже его видел -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.*" />
  </ItemGroup>

</Project>
